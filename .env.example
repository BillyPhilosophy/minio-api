# 服务端口（容器内）
PORT=3100

# MinIO / S3 连接
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# 项目注册表（JSON，单行）。apiKey 即客户端要带的 x-api-key。
# 桶白名单与项目无关，统一维护在 src/presign/allowed-buckets.ts。
PROJECTS_JSON={"galaxy":{"apiKey":"gk_换成足够长的随机串"},"blog":{"apiKey":"bk_换成足够长的随机串"}}

# 签名有效期（秒）
DEFAULT_EXPIRES_IN=900
MAX_EXPIRES_IN=3600
